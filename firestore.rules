rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    /**
     * User Profiles, Notes, and Folders
     * Rules are structured to ensure absolute data isolation.
     * A user can only access data if their Firebase Auth UID matches the document path.
     */
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Secure sub-collections (Notes & Folders)
      match /notes/{noteId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;

        // Version history snapshots (db.js saveVersion / subscribeToVersions)
        match /versions/{versionId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }
      
      match /folders/{folderId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Default deny for all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
